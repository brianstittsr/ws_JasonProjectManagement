import React from 'react';
import { BrowserRouter as Router, Routes, Route, Navigate } from 'react-router-dom';
// Remove App.css import to avoid conflicts with Tailwind

// Import pages
import AdminConfigPage from './pages/AdminConfigPage';
import TranscriptProcessingPage from './pages/TranscriptProcessingPage';
import ZoomMeetingsPage from './pages/ZoomMeetingsPage';
import PlaybooksPage from './pages/PlaybooksPage';
import InvoicesPage from './pages/InvoicesPage';
import CrisisResponsePage from './pages/CrisisResponsePage';
import BmadAnalystPage from './pages/BmadAnalystPage';

// Import ErrorBoundary
import ErrorBoundary from './components/common/ErrorBoundary';

// Import Firebase provider
import { FirebaseProvider } from './firebase';

function App() {
  return (
    <ErrorBoundary>
      <FirebaseProvider>
        <Router>
          <Routes>
            <Route path="/" element={<Navigate to="/admin/config" replace />} />
            <Route 
              path="/admin/config" 
              element={
                <ErrorBoundary fallback={<div className="p-4">Error loading Admin Config</div>}>
                  <AdminConfigPage />
                </ErrorBoundary>
              } 
            />
            <Route 
              path="/admin/transcripts" 
              element={
                <ErrorBoundary fallback={<div className="p-4">Error loading Transcript Processing</div>}>
                  <TranscriptProcessingPage />
                </ErrorBoundary>
              } 
            />
            <Route 
              path="/admin/zoom" 
              element={
                <ErrorBoundary fallback={<div className="p-4">Error loading Zoom Meetings</div>}>
                  <ZoomMeetingsPage />
                </ErrorBoundary>
              } 
            />
            <Route 
              path="/admin/playbooks" 
              element={
                <ErrorBoundary fallback={<div className="p-4">Error loading Playbooks</div>}>
                  <PlaybooksPage />
                </ErrorBoundary>
              } 
            />
            <Route 
              path="/admin/invoices" 
              element={
                <ErrorBoundary fallback={<div className="p-4">Error loading Invoices</div>}>
                  <InvoicesPage />
                </ErrorBoundary>
              } 
            />
            <Route 
              path="/admin/crisis-response" 
              element={
                <ErrorBoundary fallback={<div className="p-4">Error loading Crisis Response</div>}>
                  <CrisisResponsePage />
                </ErrorBoundary>
              } 
            />
            <Route 
              path="/admin/bmad-analyst" 
              element={
                <ErrorBoundary fallback={<div className="p-4">Error loading BMAD Analyst</div>}>
                  <BmadAnalystPage />
                </ErrorBoundary>
              } 
            />
          </Routes>
        </Router>
      </FirebaseProvider>
    </ErrorBoundary>
  );
}

export default App;
