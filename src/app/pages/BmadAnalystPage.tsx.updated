import React, { useState, useEffect } from 'react';
import { Card, CardContent, CardDescription, CardHeader, CardTitle, CardFooter } from '../components/ui/card';
import { Tabs, TabsContent, TabsList, TabsTrigger } from '../components/ui/tabs';
import { Button } from '../components/ui/button';
import { Brain, MessageSquare, Settings, AlertTriangle, RefreshCw } from 'lucide-react';
import BmadAnalystAssistant from '../components/bmad/BmadAnalystAssistant';
import { createArchonService, ArchonService } from '../services/archon.updated';
import AdminLayout from '../layouts/AdminLayout';
import { Alert, AlertDescription, AlertTitle } from '../components/ui/alert';
import { getServiceConfig, saveServiceConfig, checkServiceAvailability } from '../services/serviceConfig';
import ErrorBoundary from '../components/common/ErrorBoundary';

const BmadAnalystPage: React.FC = () => {
  const [activeTab, setActiveTab] = useState('assistant');
  const [showAssistant, setShowAssistant] = useState(false);
  const [archonService, setArchonService] = useState<ArchonService | null>(null);
  const [archonStatus, setArchonStatus] = useState<'connecting' | 'connected' | 'error' | 'not_configured'>('connecting');
  const [isLoading, setIsLoading] = useState(false);
  const [archonConfig, setArchonConfig] = useState({
    baseUrl: '',
    apiKey: '',
    vectorDb: 'pinecone',
    embeddingModel: 'text-embedding-ada-002',
    completionModel: 'gpt-4-turbo'
  });

  // Load configuration and initialize service
  useEffect(() => {
    const initializeArchon = async () => {
      try {
        // Get configuration from service config
        const config = getServiceConfig('archon');
        
        // Update local state with config
        setArchonConfig({
          baseUrl: config.baseUrl || '',
          apiKey: config.apiKey || '',
          vectorDb: config.vectorDb || 'pinecone',
          embeddingModel: config.embeddingModel || 'text-embedding-ada-002',
          completionModel: config.completionModel || 'gpt-4-turbo'
        });
        
        // Check if service is configured
        if (!config.baseUrl) {
          setArchonStatus('not_configured');
          return;
        }
        
        // Create service
        const service = await createArchonService();
        setArchonService(service);
        
        // Check availability
        const isAvailable = await checkServiceAvailability('archon');
        setArchonStatus(isAvailable ? 'connected' : 'error');
      } catch (error) {
        console.error('Failed to initialize Archon service:', error);
        setArchonStatus('error');
      }
    };

    initializeArchon();
  }, []);

  const handleOpenAssistant = () => {
    setShowAssistant(true);
  };

  const handleCloseAssistant = () => {
    setShowAssistant(false);
  };

  const handleSaveConfig = async () => {
    setIsLoading(true);
    
    try {
      // Save configuration
      saveServiceConfig('archon', {
        enabled: true,
        baseUrl: archonConfig.baseUrl,
        apiKey: archonConfig.apiKey,
        vectorDb: archonConfig.vectorDb,
        embeddingModel: archonConfig.embeddingModel,
        completionModel: archonConfig.completionModel
      });
      
      // Check availability
      const isAvailable = await checkServiceAvailability('archon');
      
      if (isAvailable) {
        // Create new service instance
        const service = await createArchonService();
        setArchonService(service);
        setArchonStatus('connected');
      } else {
        setArchonStatus('error');
      }
    } catch (error) {
      console.error('Error saving Archon config:', error);
      setArchonStatus('error');
    } finally {
      setIsLoading(false);
    }
  };

  const handleRetryConnection = async () => {
    setIsLoading(true);
    setArchonStatus('connecting');
    
    try {
      // Check availability
      const isAvailable = await checkServiceAvailability('archon');
      
      if (isAvailable) {
        // Create new service instance
        const service = await createArchonService();
        setArchonService(service);
        setArchonStatus('connected');
      } else {
        setArchonStatus('error');
      }
    } catch (error) {
      console.error('Failed to connect to Archon:', error);
      setArchonStatus('error');
    } finally {
      setIsLoading(false);
    }
  };

  // Render status indicator with appropriate message and color
  const renderStatusIndicator = () => {
    let statusColor = 'bg-yellow-500';
    let statusMessage = 'Connecting to Archon...';
    
    switch (archonStatus) {
      case 'connected':
        statusColor = 'bg-green-500';
        statusMessage = 'Connected to Archon';
        break;
      case 'error':
        statusColor = 'bg-red-500';
        statusMessage = 'Archon connection error';
        break;
      case 'not_configured':
        statusColor = 'bg-orange-500';
        statusMessage = 'Archon not configured';
        break;
      default:
        break;
    }
    
    return (
      <div className="flex items-center space-x-2 mb-6">
        <div className={`h-3 w-3 rounded-full ${statusColor}`} />
        <span className="text-sm">{statusMessage}</span>
      </div>
    );
  };

  // Render error message if needed
  const renderErrorMessage = () => {
    if (archonStatus === 'error') {
      return (
        <Alert variant="destructive" className="mb-6">
          <AlertTriangle className="h-4 w-4" />
          <AlertTitle>Connection Error</AlertTitle>
          <AlertDescription>
            Could not connect to Archon service. Please check your configuration or try again later.
            <Button 
              variant="outline" 
              size="sm" 
              className="mt-2" 
              onClick={handleRetryConnection}
              disabled={isLoading}
            >
              {isLoading ? (
                <>
                  <RefreshCw className="mr-2 h-4 w-4 animate-spin" />
                  Retrying...
                </>
              ) : (
                <>
                  <RefreshCw className="mr-2 h-4 w-4" />
                  Retry Connection
                </>
              )}
            </Button>
          </AlertDescription>
        </Alert>
      );
    }
    
    if (archonStatus === 'not_configured') {
      return (
        <Alert variant="warning" className="mb-6 border-orange-200 bg-orange-50">
          <AlertTriangle className="h-4 w-4 text-orange-600" />
          <AlertTitle className="text-orange-600">Configuration Required</AlertTitle>
          <AlertDescription className="text-orange-700">
            Archon service is not configured. Please go to the Configuration tab to set up your connection.
            <Button 
              variant="outline" 
              size="sm" 
              className="mt-2 border-orange-200 text-orange-700" 
              onClick={() => setActiveTab('configuration')}
            >
              <Settings className="mr-2 h-4 w-4" />
              Configure Archon
            </Button>
          </AlertDescription>
        </Alert>
      );
    }
    
    return null;
  };

  const content = (
    <ErrorBoundary>
      {showAssistant ? (
        <BmadAnalystAssistant 
          onClose={handleCloseAssistant} 
          archonService={archonService} 
          useFallbackMode={archonStatus !== 'connected'} 
        />
      ) : (
        <Tabs defaultValue={activeTab} onValueChange={setActiveTab} className="w-full">
          <TabsList className="grid w-full grid-cols-2">
            <TabsTrigger value="assistant">Assistant</TabsTrigger>
            <TabsTrigger value="configuration">Configuration</TabsTrigger>
          </TabsList>
          
          <TabsContent value="assistant" className="mt-6">
            <Card>
              <CardHeader>
                <CardTitle>BMAD Analyst Assistant</CardTitle>
                <CardDescription>
                  Powered by Archon Knowledge Base with RAG search for content tagged with "resbyte"
                </CardDescription>
              </CardHeader>
              <CardContent>
                <div className="flex flex-col items-center justify-center py-12 text-center">
                  <Brain size={64} className="mb-4 text-primary" />
                  <h3 className="text-2xl font-semibold mb-2">AI-Powered Business Analysis</h3>
                  <p className="text-muted-foreground mb-6 max-w-md">
                    Get market research, competitive analysis, and strategic insights using the BMAD Analyst methodology combined with your organization's knowledge.
                  </p>
                  
                  {renderStatusIndicator()}
                  {renderErrorMessage()}
                  
                  <Button 
                    size="lg" 
                    onClick={handleOpenAssistant}
                    disabled={isLoading}
                  >
                    <MessageSquare className="mr-2 h-5 w-5" />
                    {archonStatus === 'connected' 
                      ? 'Open Assistant with RAG' 
                      : 'Open Assistant (Fallback Mode)'}
                  </Button>
                  
                  {archonStatus !== 'connected' && (
                    <p className="text-sm text-muted-foreground mt-4">
                      Assistant will operate in fallback mode without RAG capabilities.
                    </p>
                  )}
                </div>
              </CardContent>
            </Card>
          </TabsContent>
          
          <TabsContent value="configuration" className="mt-6">
            <Card>
              <CardHeader>
                <CardTitle>Archon Configuration</CardTitle>
                <CardDescription>
                  Configure connection to the Archon knowledge base for RAG search
                </CardDescription>
              </CardHeader>
              <CardContent>
                <div className="space-y-4">
                  <div className="grid w-full items-center gap-1.5">
                    <label htmlFor="baseUrl" className="text-sm font-medium">API URL</label>
                    <input
                      id="baseUrl"
                      className="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
                      value={archonConfig.baseUrl}
                      onChange={(e) => setArchonConfig({...archonConfig, baseUrl: e.target.value})}
                      placeholder="http://localhost:8000"
                      disabled={isLoading}
                    />
                    <p className="text-xs text-muted-foreground mt-1">
                      Example: http://localhost:8000 or https://your-archon-instance.com
                    </p>
                  </div>
                  
                  <div className="grid w-full items-center gap-1.5">
                    <label htmlFor="apiKey" className="text-sm font-medium">API Key</label>
                    <input
                      id="apiKey"
                      type="password"
                      className="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
                      value={archonConfig.apiKey}
                      onChange={(e) => setArchonConfig({...archonConfig, apiKey: e.target.value})}
                      placeholder="Your Archon API key"
                      disabled={isLoading}
                    />
                  </div>
                  
                  <div className="grid w-full items-center gap-1.5">
                    <label htmlFor="vectorDb" className="text-sm font-medium">Vector Database</label>
                    <select
                      id="vectorDb"
                      className="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
                      value={archonConfig.vectorDb}
                      onChange={(e) => setArchonConfig({...archonConfig, vectorDb: e.target.value})}
                      disabled={isLoading}
                    >
                      <option value="pinecone">Pinecone</option>
                      <option value="qdrant">Qdrant</option>
                      <option value="chroma">Chroma</option>
                      <option value="weaviate">Weaviate</option>
                    </select>
                  </div>
                  
                  <div className="grid w-full items-center gap-1.5">
                    <label htmlFor="embeddingModel" className="text-sm font-medium">Embedding Model</label>
                    <input
                      id="embeddingModel"
                      className="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
                      value={archonConfig.embeddingModel}
                      onChange={(e) => setArchonConfig({...archonConfig, embeddingModel: e.target.value})}
                      placeholder="text-embedding-ada-002"
                      disabled={isLoading}
                    />
                  </div>
                  
                  <div className="grid w-full items-center gap-1.5">
                    <label htmlFor="completionModel" className="text-sm font-medium">Completion Model</label>
                    <input
                      id="completionModel"
                      className="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
                      value={archonConfig.completionModel}
                      onChange={(e) => setArchonConfig({...archonConfig, completionModel: e.target.value})}
                      placeholder="gpt-4-turbo"
                      disabled={isLoading}
                    />
                  </div>
                </div>
              </CardContent>
              <CardFooter>
                <Button 
                  onClick={handleSaveConfig} 
                  className="w-full"
                  disabled={isLoading}
                >
                  {isLoading ? (
                    <>
                      <RefreshCw className="mr-2 h-4 w-4 animate-spin" />
                      Saving...
                    </>
                  ) : (
                    <>
                      <Settings className="mr-2 h-4 w-4" />
                      Save Configuration
                    </>
                  )}
                </Button>
              </CardFooter>
            </Card>
          </TabsContent>
        </Tabs>
      )}
    </ErrorBoundary>
  );

  return <AdminLayout>{content}</AdminLayout>;
};

export default BmadAnalystPage;
